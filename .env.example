# ==============================================================================
# Budhiprakash Jat - Portfolio Environment Variables
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the project root.
# 2. Sign up for a free account at https://www.emailjs.com/
# 3. Create an Email Service (e.g., Gmail) and note your Service ID.
# 4. Create an Email Template with recipient {{email}} or your address (bprakashranwa@gmail.com).
# 5. Retrieve your Public Key from Account Settings > API Keys.
# 6. Fill in the keys below. Never commit your `.env` file to version control.
# ==============================================================================

# EmailJS Service ID (e.g., service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# EmailJS Template ID (e.g., template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# EmailJS Public Key / User ID (e.g., user_xxxxxxx or public_key_xxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
